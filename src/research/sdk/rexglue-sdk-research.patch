+// buffers (physical addresses) be matched; payload bytes 4..36 allow matching
+// data copied out of a bank.
+void XmaContext::TraceInputBuffer(const XMA_CONTEXT_DATA* data, const uint8_t* buffer) {
+  if (!rex::audio_trace::enabled() || !buffer) {
+    return;
+  }
+  const uint32_t address = data->GetCurrentInputBufferAddress();
+  if (address == trace_last_buffer_) {
+    return;
+  }
+  trace_last_buffer_ = address;
+  char payload[65] = {};
+  for (int i = 0; i < 32; ++i) {
+    std::snprintf(payload + i * 2, 3, "%02x", buffer[4 + i]);
+  }
+  rex::audio_trace::line("XMA", "%u	%u	0x%08X	%u	%s	%p", id(),
+                         static_cast<unsigned>(data->current_buffer), address,
+                         data->GetCurrentInputBufferPacketCount(), payload,
+                         static_cast<const void*>(buffer));
+}
