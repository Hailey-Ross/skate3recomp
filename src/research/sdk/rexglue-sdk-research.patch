diff --git a/include/rex/input/input_script.h b/include/rex/input/input_script.h
new file mode 100644
index 0000000..9726bc9
--- /dev/null
+++ b/include/rex/input/input_script.h
@@ -0,0 +1,340 @@
+// Research hooks (tracing tools; not intended for the upstream project): plays a pad script so trace sessions
+// need no hand-performed actions, and records the real pad as such a script.
+//
+// SKATE3_INPUT_SCRIPT=<file>: the script starts when L3+R3 are pressed together on the real pad (or by
+// autostart, below) and replaces the pad state while it runs. Labelled steps write "MARK <label>" lines
+// into the audio trace (rex/audio/audio_trace.h).
+//
+// Script: one step per line, "<duration> [tokens...] [# label]"; blank lines and '#' lines ignored.
+//   duration: "<n>p" = n input polls (game frames; recordings use this, so replays stay in step with
+//             the game even when it hitches or runs slower in the background), or "<ms>" = wall time
+//             (hand-written scripts).
+//   tokens:   a b x y lb rb start back up down left right l3 r3, lt rt (full) or lt=<0..1> rt=,
+//             sticks lx=<-1..1> ly= rx= ry= (up/right positive). No tokens = neutral pad.
+//   gameplay: neutral until gameplay (presence context 0x8001 == 1) has lasted the duration without a
+//             pause/loading break; the next step is timed from that point. Recordings write
+//             "10p gameplay" at every return to gameplay (after a teleport or pause), so loading times
+//             that differ between runs don't shift the inputs that follow.
+//
+// SKATE3_INPUT_RECORD=<file>: writes the real pad from the first moment of gameplay in this format, one
+// line per pad change, poll durations, sticks/triggers at full resolution (|v| < 0.02 written as 0).
+//
+// SKATE3_BACKGROUND=1: isolates the game from the real pad (state zeroed before the demo path's
+// synthetic presses, keystrokes dropped) so it can run unattended while the user plays something else.
+// SKATE3_INPUT_SCRIPT_AUTOSTART_MS=<ms>: start the script once gameplay has been active for <ms>
+// without a pause/loading break, for unattended sessions.
+
+#pragma once
+
+#include <rex/audio/audio_trace.h>
+#include <rex/input/input.h>
+#include <rex/kernel/guest_presence.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace rex::input_script {
+
+using namespace rex::input;
+
+// Polls of uninterrupted gameplay that count as "back in gameplay" (recorder sync points).
+constexpr uint32_t kSyncPolls = 10;
+
+struct Step {
+  uint32_t ms = 0;     // wall-time duration (when polls == 0)
+  uint32_t polls = 0;  // poll-count duration
+  uint16_t buttons = 0;
+  uint8_t lt = 0, rt = 0;
+  int16_t lx = 0, ly = 0, rx = 0, ry = 0;
+  bool wait_gameplay = false;
+  std::string label;
+};
+
+struct State {
+  std::mutex mutex;
+  bool loaded = false;
+  std::vector<Step> steps;
+  bool running = false;
+  bool combo_was_down = false;
+  int autostart_ms = -1;  // <0: off
+  bool autostart_armed = false;
+  std::chrono::steady_clock::time_point autostart_at;
+  size_t index = 0;
+  std::chrono::steady_clock::time_point step_start;
+  uint32_t step_polls = 0;      // polls spent in the current step
+  uint32_t gameplay_polls = 0;  // consecutive polls with presence 1
+  std::chrono::steady_clock::time_point gameplay_since;
+  // recorder
+  std::FILE* record = nullptr;
+  bool recording = false;
+  std::string record_last;
+  int64_t record_polls = 0;
+  bool record_in_gameplay = true;
+  uint32_t record_gameplay_polls = 0;
+};
+
+inline bool Background() {
+  static const bool on = [] {
+    const char* v = std::getenv("SKATE3_BACKGROUND");
+    return v && *v && *v != '0';
+  }();
+  return on;
+}
+
+// Background mode: drop the real pad (call before the demo path's synthetic presses are applied).
+inline void Isolate(X_INPUT_STATE* input_state) {
+  if (!input_state || !Background()) return;
+  input_state->gamepad.buttons = 0;
+  input_state->gamepad.left_trigger = 0;
+  input_state->gamepad.right_trigger = 0;
+  input_state->gamepad.thumb_lx = 0;
+  input_state->gamepad.thumb_ly = 0;
+  input_state->gamepad.thumb_rx = 0;
+  input_state->gamepad.thumb_ry = 0;
+}
+
+inline State& state() {
+  static State s;
+  return s;
+}
+
+inline double Clamp(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
+
+inline bool Token(const std::string& t, Step& s) {
+  static const struct { const char* name; uint16_t bit; } kButtons[] = {
+      {"up", X_INPUT_GAMEPAD_DPAD_UP}, {"down", X_INPUT_GAMEPAD_DPAD_DOWN},
+      {"left", X_INPUT_GAMEPAD_DPAD_LEFT}, {"right", X_INPUT_GAMEPAD_DPAD_RIGHT},
+      {"start", X_INPUT_GAMEPAD_START}, {"back", X_INPUT_GAMEPAD_BACK},
+      {"l3", X_INPUT_GAMEPAD_LEFT_THUMB}, {"r3", X_INPUT_GAMEPAD_RIGHT_THUMB},
+      {"lb", X_INPUT_GAMEPAD_LEFT_SHOULDER}, {"rb", X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+      {"a", X_INPUT_GAMEPAD_A}, {"b", X_INPUT_GAMEPAD_B}, {"x", X_INPUT_GAMEPAD_X},
+      {"y", X_INPUT_GAMEPAD_Y}};
+  for (const auto& b : kButtons) {
+    if (t == b.name) {
+      s.buttons |= b.bit;
+      return true;
+    }
+  }
+  if (t == "gameplay") { s.wait_gameplay = true; return true; }
+  if (t == "lt") { s.lt = 255; return true; }
+  if (t == "rt") { s.rt = 255; return true; }
+  if (t.size() > 3 && t[2] == '=') {
+    const std::string key = t.substr(0, 2);
+    const double v = std::atof(t.c_str() + 3);
+    const auto axis = [&](int16_t& out) { out = static_cast<int16_t>(std::lround(Clamp(v, -1, 1) * 32767.0)); };
+    const auto trigger = [&](uint8_t& out) { out = static_cast<uint8_t>(std::lround(Clamp(v, 0, 1) * 255.0)); };
+    if (key == "lx") { axis(s.lx); return true; }
+    if (key == "ly") { axis(s.ly); return true; }
+    if (key == "rx") { axis(s.rx); return true; }
+    if (key == "ry") { axis(s.ry); return true; }
+    if (key == "lt") { trigger(s.lt); return true; }
+    if (key == "rt") { trigger(s.rt); return true; }
+  }
+  return false;
+}
+
+inline void Load(State& st) {
+  st.loaded = true;
+  if (const char* r = std::getenv("SKATE3_INPUT_RECORD"); r && *r) st.record = std::fopen(r, "w");
+  if (const char* a = std::getenv("SKATE3_INPUT_SCRIPT_AUTOSTART_MS"); a && *a) st.autostart_ms = std::atoi(a);
+  const char* path = std::getenv("SKATE3_INPUT_SCRIPT");
+  if (!path || !*path) return;
+  std::ifstream in(path);
+  std::string line;
+  int number = 0;
+  while (std::getline(in, line)) {
+    ++number;
+    std::string label;
+    if (size_t hash = line.find('#'); hash != std::string::npos) {
+      label = line.substr(hash + 1);
+      line.resize(hash);
+      while (!label.empty() && (label.front() == ' ' || label.front() == '\t')) label.erase(0, 1);
+      while (!label.empty() && (label.back() == '\r' || label.back() == ' ')) label.pop_back();
+    }
+    std::istringstream words(line);
+    std::string word;
+    if (!(words >> word)) continue;  // comment or blank line
+    Step s;
+    if (!word.empty() && word.back() == 'p') {
+      s.polls = static_cast<uint32_t>(std::atoi(word.c_str()));
+    } else {
+      s.ms = static_cast<uint32_t>(std::atoi(word.c_str()));
+    }
+    s.label = label;
+    while (words >> word) {
+      if (!Token(word, s)) {
+        audio_trace::line("MARK", "script line %d: unknown token '%s' (script disabled)", number,
+                          word.c_str());
+        st.steps.clear();
+        return;
+      }
+    }
+    st.steps.push_back(s);
+  }
+  audio_trace::line("MARK", "script loaded: %zu steps from %s", st.steps.size(), path);
+}
+
+inline std::string Describe(const X_INPUT_STATE* in) {
+  static const struct { const char* name; uint16_t bit; } kButtons[] = {
+      {"a", X_INPUT_GAMEPAD_A}, {"b", X_INPUT_GAMEPAD_B}, {"x", X_INPUT_GAMEPAD_X},
+      {"y", X_INPUT_GAMEPAD_Y}, {"lb", X_INPUT_GAMEPAD_LEFT_SHOULDER},
+      {"rb", X_INPUT_GAMEPAD_RIGHT_SHOULDER}, {"start", X_INPUT_GAMEPAD_START},
+      {"back", X_INPUT_GAMEPAD_BACK}, {"up", X_INPUT_GAMEPAD_DPAD_UP},
+      {"down", X_INPUT_GAMEPAD_DPAD_DOWN}, {"left", X_INPUT_GAMEPAD_DPAD_LEFT},
+      {"right", X_INPUT_GAMEPAD_DPAD_RIGHT}, {"l3", X_INPUT_GAMEPAD_LEFT_THUMB},
+      {"r3", X_INPUT_GAMEPAD_RIGHT_THUMB}};
+  std::string out;
+  const uint16_t buttons = static_cast<uint16_t>(in->gamepad.buttons);
+  for (const auto& b : kButtons)
+    if (buttons & b.bit) out += std::string(" ") + b.name;
+  char text[24];
+  const struct { const char* name; uint8_t v; } kTriggers[] = {
+      {"lt", in->gamepad.left_trigger}, {"rt", in->gamepad.right_trigger}};
+  for (const auto& t : kTriggers) {
+    if (t.v == 0) continue;
+    std::snprintf(text, sizeof(text), " %s=%.3f", t.name, t.v / 255.0);
+    out += text;
+  }
+  const struct { const char* name; int16_t v; } kAxes[] = {
+      {"lx", in->gamepad.thumb_lx}, {"ly", in->gamepad.thumb_ly},
+      {"rx", in->gamepad.thumb_rx}, {"ry", in->gamepad.thumb_ry}};
+  for (const auto& a : kAxes) {
+    const double v = a.v / 32767.0;
+    if (v > -0.02 && v < 0.02) continue;
+    std::snprintf(text, sizeof(text), " %s=%.4f", a.name, v);
+    out += text;
+  }
+  return out;
+}
+
+inline void Record(State& st, const X_INPUT_STATE* in) {
+  if (!st.record) return;
+  const bool gameplay = rex::kernel::guest_presence::GameplayContextValue() == 1;
+  if (!st.recording) {
+    if (!gameplay) return;
+    st.recording = true;
+    st.record_last = Describe(in);
+    st.record_polls = 1;
+    std::fprintf(st.record, "# recorded from the first moment of gameplay; durations in polls (p)\n");
+    return;
+  }
+  // Sync point: gameplay back for kSyncPolls polls after a pause/loading. A neutral pad held through
+  // the loading is dropped (the replay waits for its own loading instead).
+  st.record_gameplay_polls = gameplay ? st.record_gameplay_polls + 1 : 0;
+  if (!gameplay) st.record_in_gameplay = false;
+  if (!st.record_in_gameplay && st.record_gameplay_polls == kSyncPolls) {
+    if (!st.record_last.empty()) {
+      std::fprintf(st.record, "%lldp%s\n", static_cast<long long>(st.record_polls - kSyncPolls + 1),
+                   st.record_last.c_str());
+    }
+    std::fprintf(st.record, "%up gameplay\n", kSyncPolls);
+    std::fflush(st.record);
+    st.record_in_gameplay = true;
+    st.record_polls = 0;
+  }
+  const std::string current = Describe(in);
+  if (current == st.record_last) {
+    ++st.record_polls;
+    return;
+  }
+  if (st.record_polls > 0) {
+    std::fprintf(st.record, "%lldp%s\n", static_cast<long long>(st.record_polls), st.record_last.c_str());
+    std::fflush(st.record);
+  }
+  st.record_last = current;
+  st.record_polls = 1;
+}
+
+inline void Mark(const Step& s) {
+  if (!s.label.empty()) audio_trace::line("MARK", "%s", s.label.c_str());
+}
+
+// Called with the real pad state each poll; rewrites it while the script runs.
+inline void Apply(X_INPUT_STATE* input_state) {
+  if (!input_state) return;
+  State& st = state();
+  std::lock_guard<std::mutex> lock(st.mutex);
+  if (!st.loaded) Load(st);
+  Record(st, input_state);
+  if (st.steps.empty()) return;
+
+  const auto now = std::chrono::steady_clock::now();
+  const bool in_gameplay = rex::kernel::guest_presence::GameplayContextValue() == 1;
+  st.gameplay_polls = in_gameplay ? st.gameplay_polls + 1 : 0;
+  if (!in_gameplay) st.gameplay_since = now;
+
+  constexpr uint16_t kCombo = X_INPUT_GAMEPAD_LEFT_THUMB | X_INPUT_GAMEPAD_RIGHT_THUMB;
+  const bool combo = (static_cast<uint16_t>(input_state->gamepad.buttons) & kCombo) == kCombo;
+  bool autostart = false;
+  if (st.autostart_ms >= 0 && !st.running) {
+    if (!in_gameplay) {
+      st.autostart_armed = false;
+    } else if (!st.autostart_armed) {
+      st.autostart_armed = true;
+      st.autostart_at = now + std::chrono::milliseconds(st.autostart_ms);
+      audio_trace::line("MARK", "gameplay active; script autostart in %d ms unless interrupted", st.autostart_ms);
+    } else if (now >= st.autostart_at) {
+      autostart = true;
+      st.autostart_ms = -1;  // once
+    }
+  }
+  if ((combo && !st.combo_was_down) || autostart) {
+    st.running = true;
+    st.index = 0;
+    st.step_start = now;
+    st.step_polls = 0;
+    audio_trace::line("MARK", "script start");
+    Mark(st.steps[0]);
+  }
+  st.combo_was_down = combo;
+  if (!st.running) return;
+
+  // Advance past finished steps. Poll steps advance by at most one poll per call, so no recorded
+  // state (a 1-poll flick) is ever skipped.
+  for (;;) {
+    const Step& cur = st.steps[st.index];
+    bool done;
+    if (cur.wait_gameplay) {
+      done = cur.polls ? st.gameplay_polls >= cur.polls
+                       : in_gameplay && now - st.gameplay_since >= std::chrono::milliseconds(cur.ms);
+    } else if (cur.polls) {
+      done = st.step_polls >= cur.polls;
+    } else {
+      done = now - st.step_start >= std::chrono::milliseconds(cur.ms);
+    }
+    if (!done) break;
+    if (!cur.polls && !cur.wait_gameplay) {
+      st.step_start += std::chrono::milliseconds(cur.ms);
+    } else {
+      st.step_start = now;
+    }
+    st.step_polls = 0;
+    if (++st.index >= st.steps.size()) {
+      st.running = false;
+      audio_trace::line("MARK", "script end");
+      return;
+    }
+    Mark(st.steps[st.index]);
+  }
+  ++st.step_polls;
+  const Step& s = st.steps[st.index];
+  input_state->gamepad.buttons = s.buttons;
+  input_state->gamepad.left_trigger = s.lt;
+  input_state->gamepad.right_trigger = s.rt;
+  input_state->gamepad.thumb_lx = s.lx;
+  input_state->gamepad.thumb_ly = s.ly;
+  input_state->gamepad.thumb_rx = s.rx;
+  input_state->gamepad.thumb_ry = s.ry;
+  input_state->packet_number = static_cast<uint32_t>(input_state->packet_number) + 1;
+}
+
+}  // namespace rex::input_script
