diff --git a/include/rex/audio/audio_trace.h b/include/rex/audio/audio_trace.h
new file mode 100644
index 0000000..2215686
--- /dev/null
+++ b/include/rex/audio/audio_trace.h
@@ -0,0 +1,168 @@
+// Research hooks (tracing tools; not intended for the upstream project): records which
+// sound data the game reads and decodes, so retail sound choices can be
+// measured. Enabled only when SKATE3_AUDIO_TRACE_FILE names an output file.
+// One line per event, tab-separated, first field = milliseconds since start:
+//   READ <ms> <path> <file offset> <length> <guest address>
+//   XMA  <ms> <context> <buffer index> <guest address> <packet count>
+//
+// ONE writer per process (2026-10-02). The exe (game hooks) and the runtime DLL (kernel, XMA, input)
+// each compile this header, so each has its own copy of these statics. Before, both opened the file in
+// text-mode append and wrote independently: the CRT split their writes and the two streams interleaved
+// mid-line (malformed / empty lines). Now the first module to initialise becomes the OWNER: it opens the
+// file (binary append), runs the only writer thread and publishes a plain C function pointer
+// `append(data, n)` in a process environment variable. The other module never touches the file; its
+// line() formats locally and calls the owner's append. No STL object or heap memory crosses the module
+// boundary (the two modules may use different CRT heaps). Owner election is serialised by a named mutex.
+// Light mode: game threads only format + append under a short lock; the writer thread writes one batch per
+// 100 ms with a single fwrite + fflush (a crash loses at most ~100 ms of lines).
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <thread>
+#if defined(_WIN32)
+// kernel32, declared here to keep <Windows.h> (and its macros) out of every includer.
+extern "C" __declspec(dllimport) unsigned long __stdcall GetEnvironmentVariableA(const char*, char*,
+                                                                                 unsigned long);
+extern "C" __declspec(dllimport) int __stdcall SetEnvironmentVariableA(const char*, const char*);
+struct _SECURITY_ATTRIBUTES;  // same signature as <synchapi.h> (LPSECURITY_ATTRIBUTES, BOOL, LPCSTR)
+extern "C" __declspec(dllimport) void* __stdcall CreateMutexA(_SECURITY_ATTRIBUTES*, int, const char*);
+extern "C" __declspec(dllimport) unsigned long __stdcall WaitForSingleObject(void*, unsigned long);
+extern "C" __declspec(dllimport) int __stdcall ReleaseMutex(void*);
+extern "C" __declspec(dllimport) unsigned long __stdcall GetCurrentProcessId();
+#endif
+
+namespace rex::audio_trace {
+
+using AppendFn = void (*)(const char* data, int size);
+
+// Owner side: the pending buffer and the file, used only by the owner module.
+struct OwnerSink {
+  std::mutex mutex;
+  std::string pending;
+  std::FILE* file = nullptr;
+};
+
+inline OwnerSink& owner_sink() {
+  static OwnerSink sink;
+  return sink;
+}
+
+// The owner's append (published to the other module as a plain function pointer).
+inline void owner_append(const char* data, int size) {
+  OwnerSink& sink = owner_sink();
+  std::lock_guard<std::mutex> lock(sink.mutex);
+  sink.pending.append(data, static_cast<size_t>(size));
+}
+
+inline void owner_writer_loop() {
+  OwnerSink& sink = owner_sink();
+  std::string batch;
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    {
+      std::lock_guard<std::mutex> lock(sink.mutex);
+      batch.swap(sink.pending);
+    }
+    if (!batch.empty()) {
+      std::fwrite(batch.data(), 1, batch.size(), sink.file);
+      std::fflush(sink.file);
+      batch.clear();
+    }
+  }
+}
+
+struct State {
+  AppendFn append = nullptr;  // owner_append (this module or the other); null = tracing disabled
+  bool owner = false;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  State() {
+    const char* path = std::getenv("SKATE3_AUDIO_TRACE_FILE");
+    if (!path || !*path) return;
+#if defined(_WIN32)
+    char name[64];
+    std::snprintf(name, sizeof name, "Local\\skate3_audio_trace_%lu", GetCurrentProcessId());
+    void* election = CreateMutexA(nullptr, 0, name);
+    if (election) WaitForSingleObject(election, 0xFFFFFFFFu);
+    char shared[32] = {};
+    if (GetEnvironmentVariableA("SKATE3_AUDIO_TRACE_SINK", shared, sizeof(shared)) > 0) {
+      // The other module owns the file: use its append and its time zero.
+      append = reinterpret_cast<AppendFn>(static_cast<uintptr_t>(std::strtoull(shared, nullptr, 16)));
+      char t0[32] = {};
+      if (GetEnvironmentVariableA("SKATE3_AUDIO_TRACE_T0", t0, sizeof(t0)) > 0) {
+        start = std::chrono::steady_clock::time_point(std::chrono::steady_clock::duration(std::strtoll(t0, nullptr, 10)));
+      }
+    } else {
+      OwnerSink& sink = owner_sink();
+      sink.file = std::fopen(path, "ab");  // binary: no CRT newline translation, one write per batch
+      if (sink.file) {
+        owner = true;
+        append = &owner_append;
+        std::snprintf(shared, sizeof shared, "%llx",
+                      static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(append)));
+        SetEnvironmentVariableA("SKATE3_AUDIO_TRACE_T0", std::to_string(start.time_since_epoch().count()).c_str());
+        SetEnvironmentVariableA("SKATE3_AUDIO_TRACE_SINK", shared);
+        // The wall-clock time of the time zero (unix ms), for screenshots.
+        const auto unix_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                 std::chrono::system_clock::now().time_since_epoch()).count();
+        std::fprintf(sink.file, "CLOCK\t0.0\t%lld\n", static_cast<long long>(unix_ms));
+        std::fflush(sink.file);
+        std::thread(owner_writer_loop).detach();
+      }
+    }
+    if (election) ReleaseMutex(election);  // the handle stays open for the process lifetime
+#else
+    OwnerSink& sink = owner_sink();
+    sink.file = std::fopen(path, "ab");
+    if (sink.file) {
+      owner = true;
+      append = &owner_append;
+      std::thread(owner_writer_loop).detach();
+    }
+#endif
+  }
+  ~State() {
+    // Process exit: the writer thread may already be gone; write what is left without waiting for it.
+    if (!owner) return;
+    OwnerSink& sink = owner_sink();
+    if (sink.file && sink.mutex.try_lock()) {
+      std::fwrite(sink.pending.data(), 1, sink.pending.size(), sink.file);
+      std::fflush(sink.file);
+      sink.pending.clear();
+      sink.mutex.unlock();
+    }
+  }
+};
+
+inline State& state() {
+  static State s;
+  return s;
+}
+
+inline bool enabled() { return state().append != nullptr; }
+
+// printf-style; a newline is appended. Formats on the calling thread, then hands the complete line to the
+// process's single writer.
+inline void line(const char* kind, const char* format, ...) {
+  State& s = state();
+  if (!s.append) return;
+  const auto ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - s.start).count();
+  char buffer[2048];
+  int n = std::snprintf(buffer, sizeof buffer, "%s\t%.1f\t", kind, ms);
+  if (n < 0) return;
+  va_list args;
+  va_start(args, format);
+  const int m = std::vsnprintf(buffer + n, sizeof buffer - n - 1, format, args);
+  va_end(args);
+  n = m < 0 ? n : std::min<int>(n + m, static_cast<int>(sizeof buffer) - 2);
+  buffer[n++] = '\n';
+  s.append(buffer, n);
+}
+
+}  // namespace rex::audio_trace
